<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="4.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ImportGroup Label="PropertySheets" />
  <PropertyGroup Label="UserMacros">
    <AndroidSuffixLib>$([System.String]::new($(Configuration)).Replace('Release', '').Replace('Debug', 'd'))</AndroidSuffixLib>
    <AndroidSuffixLib2>$([System.String]::new($(Configuration)).Replace('Release', '').Replace('Debug', '_d'))</AndroidSuffixLib2>
  </PropertyGroup>
  <PropertyGroup />
  <ItemDefinitionGroup>
    <Link>
      <LibraryDependencies>assimp$(AndroidSuffixLib);boost_atomic;boost_charconv;boost_chrono;boost_container;boost_date_time;boost_filesystem;boost_locale;boost_program_options;boost_serialization;boost_thread;boost_wserialization;brotlicommon;brotlidec;brotlienc;bz2$(AndroidSuffixLib);cryptopp;date-tz;deflate;draco;fmt$(AndroidSuffixLib);fmt-c;FreeImage$(AndroidSuffixLib);FreeImagePlus$(AndroidSuffixLib);freetype$(AndroidSuffixLib);glm;gmock;gslcblas$(AndroidSuffixLib);gsl$(AndroidSuffixLib);gtest;Iex-3_4$(AndroidSuffixLib2);IlmThread-3_4$(AndroidSuffixLib2);Imath-3_2$(AndroidSuffixLib2);jasper$(AndroidSuffixLib);jpeg;jpegxr$(AndroidSuffixLib);jxrglue$(AndroidSuffixLib);kubazip;lcms2;lzma;minizip;OpenEXR-3_4$(AndroidSuffixLib2);OpenEXRCore-3_4$(AndroidSuffixLib2);OpenEXRUtil-3_4$(AndroidSuffixLib2);openjp2;openjph$(AndroidSuffixLib2);png;png16$(AndroidSuffixLib);poly2tri;polyclipping;pugixml;raw_r;RmlCore;RmlDebugger;sharpyuv;snappy;tiff$(AndroidSuffixLib);tinyobjloader;turbojpeg;webp;webpdecoder;webpdemux;webpmux;z;%(LibraryDependencies)</LibraryDependencies>
    </Link>
  </ItemDefinitionGroup>
  <ItemGroup>
    <BuildMacro Include="AndroidSuffixLib">
      <Value>$(AndroidSuffixLib)</Value>
    </BuildMacro>
    <BuildMacro Include="AndroidSuffixLib2">
      <Value>$(AndroidSuffixLib2)</Value>
    </BuildMacro>
  </ItemGroup>
</Project>